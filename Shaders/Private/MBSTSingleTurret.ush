#ifndef MBST_SINGLE_TURRET_USH
#define MBST_SINGLE_TURRET_USH

// Packed wire format (must match MBSTPacking in MBSTSingleTurretTypes.h):
// bits  0.. 7 = visual style (0..255)
// bits  8..19 = yaw         (-180..180 degrees, 12 bit)
// bits 20..27 = pitch       (-90..90 degrees, 8 bit)
// bits 28..31 = recoil      (0..1, 4 bit)

#define MBST_STYLE_SHIFT 0u
#define MBST_YAW_SHIFT 8u
#define MBST_PITCH_SHIFT 20u
#define MBST_RECOIL_SHIFT 28u

#define MBST_STYLE_MASK 255u
#define MBST_YAW_MASK 4095u
#define MBST_PITCH_MASK 255u
#define MBST_RECOIL_MASK 15u

// Material Dynamic Parameters are floats. Two values in [0, 65535] retain
// every bit exactly, unlike converting an arbitrary packed int32 to one float.
int MBST_CombinePackedUInt16Halves(float2 PackedLowHigh)
{
    uint PackedLow = ((uint)round(PackedLowHigh.x)) & 65535u;
    uint PackedHigh = ((uint)round(PackedLowHigh.y)) & 65535u;
    return asint(PackedLow | (PackedHigh << 16u));
}

float MBST_DequantizeRange(uint Quantized, float MinValue, float MaxValue, uint MaxQuantized)
{
    return lerp(MinValue, MaxValue, (float)Quantized / (float)MaxQuantized);
}

void MBST_DecodePackedState(
    int PackedState,
    out int VisualStyle,
    out float YawDegrees,
    out float PitchDegrees,
    out float RecoilNormalized)
{
    uint Packed = asuint(PackedState);
    uint StyleQ = (Packed >> MBST_STYLE_SHIFT) & MBST_STYLE_MASK;
    uint YawQ = (Packed >> MBST_YAW_SHIFT) & MBST_YAW_MASK;
    uint PitchQ = (Packed >> MBST_PITCH_SHIFT) & MBST_PITCH_MASK;
    uint RecoilQ = (Packed >> MBST_RECOIL_SHIFT) & MBST_RECOIL_MASK;

    VisualStyle = (int)StyleQ;
    YawDegrees = MBST_DequantizeRange(YawQ, -180.0f, 180.0f, MBST_YAW_MASK);
    PitchDegrees = MBST_DequantizeRange(PitchQ, -90.0f, 90.0f, MBST_PITCH_MASK);
    RecoilNormalized = MBST_DequantizeRange(RecoilQ, 0.0f, 1.0f, MBST_RECOIL_MASK);
}

void MBST_DecodePackedStateSinCos(
    int PackedState,
    out int VisualStyle,
    out float4 YawPitchSinCos,
    out float RecoilNormalized)
{
    float YawDegrees;
    float PitchDegrees;
    MBST_DecodePackedState(PackedState, VisualStyle, YawDegrees, PitchDegrees, RecoilNormalized);

    float SinYaw;
    float CosYaw;
    float SinPitch;
    float CosPitch;
    sincos(radians(YawDegrees), SinYaw, CosYaw);
    sincos(radians(PitchDegrees), SinPitch, CosPitch);
    YawPitchSinCos = float4(SinYaw, CosYaw, SinPitch, CosPitch);
}

// Compact GPU-particle ABI carried by DynamicMaterialParameter1:
// x = sin(yaw), y = cos(yaw), z = sin(pitch), w = recoil [0, 1].
// Pitch is constrained to [-90, 90], therefore cos(pitch) is non-negative.
float4 MBST_ExpandCompactArticulation(float4 ArticulationParams)
{
    float2 YawSinCos = ArticulationParams.xy;
    const float YawLengthSquared = dot(YawSinCos, YawSinCos);
    YawSinCos = YawLengthSquared > 1.0e-8f
        ? YawSinCos * rsqrt(YawLengthSquared)
        : float2(0.0f, 1.0f);

    const float SinPitch = clamp(ArticulationParams.z, -1.0f, 1.0f);
    const float CosPitch = sqrt(saturate(1.0f - SinPitch * SinPitch));
    return float4(YawSinCos, SinPitch, CosPitch);
}

float3 MBST_RotateAxisSinCos(float3 Vector, float3 Axis, float SinAngle, float CosAngle)
{
    Axis = normalize(Axis + float3(1.0e-8f, 0.0f, 0.0f));
    return Vector * CosAngle
        + cross(Axis, Vector) * SinAngle
        + Axis * dot(Axis, Vector) * (1.0f - CosAngle);
}

float3 MBST_RotatePointAroundPivot(
    float3 Point,
    float3 Pivot,
    float3 Axis,
    float SinAngle,
    float CosAngle)
{
    return Pivot + MBST_RotateAxisSinCos(Point - Pivot, Axis, SinAngle, CosAngle);
}

// VertexColor convention generated by the editor converter:
// R = yaw weight, G = pitch weight, B = body VAT weight, A = recoil weight.
float3 MBST_ArticulatePositionObjectSpace(
    float3 PositionObject,
    float4 VertexMask,
    float3 TurretPivotObject,
    float3 TurretAxisObject,
    float3 BarrelPivotObject,
    float3 BarrelAxisObject,
    float3 BarrelForwardObject,
    float4 YawPitchSinCos,
    float RecoilDistance)
{
    const float YawWeight = saturate(VertexMask.r);
    const float PitchWeight = saturate(VertexMask.g);
    const float RecoilWeight = saturate(VertexMask.a);

    float3 PositionAfterRecoil = PositionObject
        - normalize(BarrelForwardObject + float3(1.0e-8f, 0.0f, 0.0f))
        * RecoilDistance
        * RecoilWeight;

    float3 PitchRotated = MBST_RotatePointAroundPivot(
        PositionAfterRecoil,
        BarrelPivotObject,
        BarrelAxisObject,
        YawPitchSinCos.z,
        YawPitchSinCos.w);
    float3 AfterPitch = lerp(PositionAfterRecoil, PitchRotated, PitchWeight);

    float3 YawRotated = MBST_RotatePointAroundPivot(
        AfterPitch,
        TurretPivotObject,
        TurretAxisObject,
        // Rodrigues' cross(Axis, Vector) form has the same signed-axis
        // convention as UE's FQuat(Axis, Angle).  AimTurretAtWorldLocation
        // therefore feeds this value directly: +90 about +Z maps +X to +Y.
        YawPitchSinCos.x,
        YawPitchSinCos.y);

    return lerp(AfterPitch, YawRotated, YawWeight);
}

float3 MBST_ArticulateNormalObjectSpace(
    float3 NormalObject,
    float4 VertexMask,
    float3 TurretAxisObject,
    float3 BarrelAxisObject,
    float4 YawPitchSinCos)
{
    const float YawWeight = saturate(VertexMask.r);
    const float PitchWeight = saturate(VertexMask.g);

    float3 PitchRotated = MBST_RotateAxisSinCos(
        NormalObject,
        BarrelAxisObject,
        YawPitchSinCos.z,
        YawPitchSinCos.w);
    float3 AfterPitch = normalize(lerp(NormalObject, PitchRotated, PitchWeight));

    float3 YawRotated = MBST_RotateAxisSinCos(
        AfterPitch,
        TurretAxisObject,
        YawPitchSinCos.x,
        YawPitchSinCos.y);
    return normalize(lerp(AfterPitch, YawRotated, YawWeight));
}

#endif // MBST_SINGLE_TURRET_USH
